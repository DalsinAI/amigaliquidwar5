ALLEGRO_DAT = @ALLEGRO_DAT@

MIDI = clarity.mid \
	fodder.mid \
	headless.mid \
        marauder.mid \
	return.mid \
        thmoov.mid \
	torqued.mid

all: music.dat

music.dat: $(MIDI)
	@rm -f $@
	@echo Creating music.dat
	@$(ALLEGRO_DAT) -a -t midi music.dat $(MIDI)

clean:
	@rm -f *.dat

distclean:
	@rm -f Makefile


